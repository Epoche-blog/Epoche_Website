---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Epoché">
  <header class="masthead">
    <h1 class="wordmark">Epoché</h1>
    <p class="definition"><span class="term">epoché</span>, n. — the suspension of judgment; setting assumptions aside to look at something plainly.</p>
  </header>

  <nav class="index" aria-label="Site sections">
    <a class="index-field" href="/philosophy">
      <div>
        <div class="label">Philosophy</div>
        <p class="desc">Writing on epoché, process, and building things well.</p>
      </div>
      <span class="enter">Read</span>
    </a>
    <a class="index-field" href="/portfolio">
      <div>
        <div class="label">Portfolio</div>
        <p class="desc">Manufacturing systems, automation, and builds.</p>
      </div>
      <span class="enter">View</span>
    </a>
    <a class="index-field" href="/contact">
      <div>
        <div class="label">Contact</div>
        <p class="desc">Get in touch.</p>
      </div>
      <span class="enter">Get in touch</span>
    </a>
  </nav>
</Layout>
