---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Philosophy | Epoché">
  <div class="sub-header">
    <a class="crumb" href="/">← Epoché</a>
    <h1 class="sub-title">Philosophy</h1>
    <span></span>
  </div>
  <div class="content-area">
    <p>Writing on epoché as a practice — bracketing assumptions to look at process, tools, and work plainly.</p>

    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-entry" href={`/philosophy/${post.id}`}>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <div>
              <div class="post-title">{post.data.title}</div>
              <p class="excerpt">{post.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="construction-note">No posts yet. First one is coming soon.</div>
    )}
  </div>
</Layout>
